[BuildOptions]
  # MSVC /GL+LTCG forbids user-defined CRT helpers (C2268); the app provides
  # memcpy/memset shims for optimizer-generated calls under /NODEFAULTLIB.
  MSFT:*_*_*_CC_FLAGS = /GL-
